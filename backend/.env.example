# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Delhivery
DELHIVERY_API_KEY=your-delhivery-token
# staging | production — switches base URL between staging-express.delhivery.com and track.delhivery.com
DELHIVERY_ENV=staging
# Optional. Leave unset until a live Delhivery pincode/serviceability-derived
# zone endpoint is confirmed in sandbox (zone resolution Path 1).
DELHIVERY_ZONE_API_PATH=

# Rate engine: fuel surcharge is no longer a static env default — it lives on
# the current rate card row (supabase/migrations/0005_rate_card_versioning.sql)
# and is edited via the rate-card admin routes, versioned like slab prices.

# Tracking poller
TRACKING_POLL_INTERVAL_MINUTES=15

# Server
PORT=8080
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

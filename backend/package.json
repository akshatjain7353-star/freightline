{
  "name": "freightline-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "sync-catalog": "node scripts/try-sync-feature-catalog.mjs",
    "prebuild": "node scripts/try-sync-feature-catalog.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test": "SUPABASE_URL=https://example.supabase.co SUPABASE_SERVICE_ROLE_KEY=phase1-offline-test tsx --test src/lib/*.test.ts src/rate-engine/*.test.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "cleanup:demo": "tsx scripts/cleanup-demo-data.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
